{
  "expo": {
    "name": "Eco Fetch",
    "slug": "eco-fetch",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ecofetch",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ecofetch.app",
      "config": {
        "googleMapsApiKey": "AIzaSyBkAxCKrRkaWfhIpsUK1x3Shs8SZZmgdvI"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Eco Fetch needs your location to find nearby collectors and track pickups.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Eco Fetch needs your location to find nearby collectors and track pickups.",
        "NSCameraUsageDescription": "Eco Fetch may need camera access for profile photos.",
        "NSMicrophoneUsageDescription": "Eco Fetch needs microphone access for audio alerts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1AB045"
      },
      "package": "com.ecofetch.app",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBkAxCKrRkaWfhIpsUK1x3Shs8SZZmgdvI"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://ecofetch.vercel.app/"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F97316",
          "sounds": [
            "./assets/sounds/ringtone.mp3"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1AB045"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Eco Fetch needs your location to find nearby collectors."
        }
      ],
      ["@stripe/stripe-react-native", { "merchantIdentifier": "" }],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "6c6599d7-7588-4bac-b8cd-667b7c7afcd2"
      },
      "router": {
        "origin": "https://ecofetch.vercel.app/"
      }
    },
    "owner": "phikolz"
  }
}
